# Copy this file to .env for local development.
# In production, these are injected via the deployment platform / secrets manager,
# never committed to the repo.

PORT=3000
NODE_ENV=development
# LOG_LEVEL controls verbosity: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# --- Tracing (OpenTelemetry -> Grafana Tempo) ---
# Tempo's OTLP HTTP receiver, typically exposed on port 4318 in the
# monitoring docker-compose stack (see monitoring/).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=customer-api
